 "facts": [
  {
   "text": "崇祯十七年三月十九日（1644年4月25日），李自成军攻入北京，崇祯帝自缢于煤山（今景山）",
   "match": [
    "1644"
   ],
   "source": "搜索摘要：https://www.chinanews.com.cn/cul/2011/09-09/3319423.shtml ；https://dbpedia.org/page/Chongzhen （网络受限，未打开原文核对）"
  },
  {
   "text": "顺治元年五月十五日（1644年6月19日），福王朱由崧在南京即位，建元弘光",
   "match": [
    "1644",
    "6"
   ],
   "source": "搜索摘要：https://www.dpm.org.cn/court/event/159031.html （故宫博物院）；https://zh.wikipedia.org/zh-hans/弘光帝 （未打开原文核对）"
  },
  {
   "text": "1645年清军攻扬州，四月二十五日（5月20日）城破，史可法殉难；同年五月南京降，弘光帝被俘",
   "match": [
    "1645"
   ],
   "source": "搜索摘要：https://baike.baidu.com/item/史可法/1490 ；https://www.dpm.org.cn/court/event/159031.html （未打开原文核对；屠城伤亡数字各说不一，片中不讲）"
  },
  {
   "text": "1645年8月18日唐王朱聿键在福州即位，建元隆武；1646年10月6日在汀州被清军俘杀",
   "match": [
    "1646"
   ],
   "source": "搜索摘要：https://zh.wikipedia.org/zh-hans/隆武帝 ；https://ctext.org/datawiki.pl?if=gb&res=695386 （未打开原文核对）"
  },
  {
   "text": "1646年冬，桂王朱由榔在肇庆即位，建元永历（公历1646年12月24日）",
   "match": [
    "1646"
   ],
   "source": "搜索摘要：https://www.dpm.org.cn/court/event/160186.html （故宫博物院）；https://baike.baidu.com/item/永历/61937 （未打开原文核对）"
  },
  {
   "text": "永历六年（1652年），李定国克桂林（孔有德自焚）、衡阳之战尼堪阵亡；黄宗羲：“两蹶名王，天下震动”",
   "match": [
    "1652"
   ],
   "source": "搜索摘要：https://baike.baidu.com/item/李定国两蹶名王/4175894 ；https://zhuanlan.zhihu.com/p/25226282 （黄宗羲原文未逐字核对）"
  },
  {
   "text": "永历十年（1656年）三月，李定国将永历帝自安龙迎至昆明",
   "match": [
    "1656"
   ],
   "source": "搜索摘要：http://www.guoxue123.com/new/0001/nms/123.htm （顾诚《南明史》第三节）（未打开原文核对）"
  },
  {
   "text": "1659年闰正月，永历帝由永昌经盏达进入缅甸",
   "match": [
    "1659"
   ],
   "source": "搜索摘要：https://baike.baidu.com/item/永历帝入缅/20293965 ；http://www.guoxue123.com/new/0001/nms/134.htm （未打开原文核对）"
  },
  {
   "text": "郑成功1661年4月末登陆台湾，围台湾城（热兰遮城）；1662年2月1日荷方签约投降，结束荷兰东印度公司对台湾38年的统治",
   "match": [
    "1661",
    "1662",
    "38"
   ],
   "source": "搜索摘要：https://www.news.cn/tw/20250429/de56687342634a7db5ecdd4087556d33/c.html （新华网）；https://baike.baidu.com/item/郑成功收复台湾/2101801 （未打开原文核对）"
  },
  {
   "text": "1662年4月缅王莽白将永历帝交给吴三桂；永历十六年四月十五日（1662年6月1日），永历帝在昆明篦子坡遇害",
   "match": [
    "1662"
   ],
   "source": "搜索摘要：https://baike.baidu.com/item/永历帝入缅/20293965 ；https://en.wikipedia.org/wiki/1662_in_China （未打开原文核对）"
  },
  {
   "text": "1644年至1662年，共18年（1662 − 1644 = 18）",
   "match": [
    "18"
   ],
   "source": "年份相减"
  }
 ],
