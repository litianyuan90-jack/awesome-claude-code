 "facts": [
  {
   "text": "德祐二年（1276年）二月，元军进入临安，南宋朝廷奉表投降（2月4日元军攻占临安，二月初五受降）",
   "match": [
    "1276",
    "2"
   ],
   "source": "搜索摘要：https://zh.wikipedia.org/zh-hans/临安之战 ；https://www.sohu.com/a/363550457_100028727 （网络受限，未打开原文核对）"
  },
  {
   "text": "临安投降前夜，益王赵昰、广王赵昺在杨镇、杨亮节护送下出城，经婺州（今金华）至温州",
   "match": [],
   "source": "搜索摘要：https://www.sohu.com/a/363550457_100028727 （未打开原文核对）"
  },
  {
   "text": "景炎元年（1276年）五月初一，赵昰在福州即位，是为宋端宗",
   "match": [
    "1276",
    "5"
   ],
   "source": "搜索摘要：https://zh.wikipedia.org/zh-cn/宋端宗 ；https://data.ctext.org/entity/623753 （未打开原文核对）"
  },
  {
   "text": "1276年十一月元军入闽，张世杰护端宗至泉州，提举市舶蒲寿庚闭城拒纳，旋降元",
   "match": [],
   "source": "搜索摘要：http://www.mnwhstq.com/szzy/qzrwk/201608/t20160815_84680.htm ；http://www.eeo.com.cn/2025/0324/717993.shtml （未打开原文核对）"
  },
  {
   "text": "流亡朝廷经潮州、惠州甲子门，景炎二年（1277年）至官富场（今香港九龙一带）",
   "match": [
    "1277"
   ],
   "source": "搜索摘要：https://zh.wikipedia.org/zh-tw/宋端宗 ；https://zhuanlan.zhihu.com/p/29702586 （未打开原文核对）"
  },
  {
   "text": "景炎二年十二月，端宗至井澳，遇飓风，舟败，端宗落水，得疾",
   "match": [],
   "source": "搜索摘要：https://zh.wikipedia.org/zh-tw/宋端宗 ；https://en.wikipedia.org/wiki/Emperor_Duanzong （未打开原文核对）"
  },
  {
   "text": "景炎三年四月（1278年5月），端宗崩于碙洲（碙洲今地有湛江硇洲岛、香港大屿山等说，片中不标位置）；陆秀夫等立赵昺，五月改元祥兴",
   "match": [
    "1278",
    "5"
   ],
   "source": "搜索摘要：https://zh.wikipedia.org/zh-hans/赵昺 ；https://en.wikipedia.org/wiki/Emperor_Duanzong （未打开原文核对）"
  },
  {
   "text": "祥兴元年六月（1278年6月），赵昺徙居崖山（今广东江门新会崖门）",
   "match": [
    "1278",
    "6"
   ],
   "source": "搜索摘要：https://zh.wikipedia.org/zh-hans/赵昺 （未打开原文核对）"
  },
  {
   "text": "张世杰将千余艘战船以大索连为一字阵，四周起楼棚，涂泥以防火攻",
   "match": [
    "1000"
   ],
   "source": "搜索摘要：https://baike.baidu.com/item/崖山海战/10764308 ；https://www.thepaper.cn/newsDetail_forward_14765761 （未打开原文核对）"
  },
  {
   "text": "文天祥1278年十二月于五坡岭被俘；1279年正月被元军挟持经零丁洋，作《过零丁洋》，末句“人生自古谁无死，留取丹心照汗青”",
   "match": [
    "1279"
   ],
   "source": "https://www.zhmuseum.org.cn/wen/wenwugushiInfo?id=9 ；https://www.classicalchineseliterature.org/article.php?article=過零丁洋 （搜索摘要，未打开原文核对）"
  },
  {
   "text": "元军封锁海湾，断宋军汲水、樵采之路，宋军食干粮，渴甚",
   "match": [],
   "source": "搜索摘要：https://baike.baidu.com/item/崖山海战/10764308 （“饮海水即呕泄”出自《宋史·张世杰传》，未逐字核对，故旁白不用）"
  },
  {
   "text": "祥兴二年二月初六（1279年3月19日），张弘范四面合攻，宋军溃败；陆秀夫负帝昺投海",
   "match": [
    "1279",
    "3",
    "19"
   ],
   "source": "搜索摘要：https://baike.baidu.com/item/崖山海战/10764308 ；https://www.chinanews.com.cn/m/cul/2017/03-19/8177743.shtml （未打开原文核对）"
  },
  {
   "text": "1276年临安降元至1279年崖山之战，约3年",
   "match": [
    "3"
   ],
   "source": "年份相减：1279 − 1276 = 3"
  }
 ],
